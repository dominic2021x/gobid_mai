ASSISTANT_AI_DYNAMIC_THRESHOLD_CHARS=2200

OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
