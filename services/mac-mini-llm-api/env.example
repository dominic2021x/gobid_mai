PORT=8787
OLLAMA_TIMEOUT_MS=120000
CONTEXT_MAX_CHARS=8000
CONVERSATION_MAX_MESSAGES=6

# Rutare modele (același modul ca Next — prefix ASSISTANT_AI_)
ASSISTANT_AI_MODEL_FAST=gemma:7b-instruct-q4_K_M
ASSISTANT_AI_MODEL_DEFAULT=mistral:7b-instruct-q5_K_M
ASSISTANT_AI_MODEL_FALLBACK=llama3:8b-instruct-q4_K_M
