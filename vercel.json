{
  "installCommand": "npm install --include=optional",
  "functions": {
    "app/api/**": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "gobid.ro" }],
      "destination": "https://www.gobid.ro/$1",
      "permanent": true
    }
  ],
  "crons": [
    {"path": "/api/cron/healthcheck", "schedule": "5 0 * * *"},
    {"path": "/api/cron/healthcheck", "schedule": "5 1 * * *"},
    {"path": "/api/cron/autopromo", "schedule": "0 10 * * *"},
    {"path": "/api/cron/sync-stats", "schedule": "0 */6 * * *"},
    {"path": "/api/cron/anaf-import", "schedule": "0 8 * * *"},
    {"path": "/api/exchange-rate/update", "schedule": "0 11 * * *"},
    {"path": "/api/agents/openclaw/worker", "schedule": "*/5 * * * *"},
    {"path": "/api/jobs/seed-suggestions", "schedule": "*/5 * * * *"},
    {"path": "/api/jobs/aggregate-suggestion-stats", "schedule": "0 */6 * * *"},
    {"path": "/api/jobs/aggregate-autocorrect-stats", "schedule": "0 */6 * * *"},
    {"path": "/api/cron/saved-search-alerts", "schedule": "*/15 * * * *"},
    {"path": "/api/cron/cache-events-cleanup", "schedule": "0 3 * * *"}
  ]
}
